# Node 24.11+; PostgreSQL 17. Set unique secrets before starting.
NODE_ENV=development
PORT=4007
APP_ORIGIN=http://localhost:5177
DATABASE_URL=postgresql://parvath:replace-me@localhost:5432/parvath
SESSION_SECRET=replace-with-at-least-32-random-characters
# Demo only. Leave blank in production; seeding refuses production.
DEMO_DATE=2026-09-04T06:30:00.000Z
TRUST_PROXY=0
# Private S3 bucket. Empty values disable uploads with a useful error.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=parvath-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
# ClamAV INSTREAM scanner. No scanner = files remain quarantined.
CLAMAV_HOST=
CLAMAV_PORT=3310
# SMTP is required for password-reset delivery.
SMTP_URL=
MAIL_FROM=Parvath FinServ <no-reply@example.com>

# Dedicated test database; never point this at a production database.
TEST_DATABASE_URL=postgresql://parvath:replace-me@localhost:5432/parvath_test
# Docker Compose infrastructure passwords; generate distinct random values.
POSTGRES_PASSWORD=replace-with-random-password
# Initial administrator; set via environment when running admin:create.
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=generate-a-unique-12-plus-character-password
